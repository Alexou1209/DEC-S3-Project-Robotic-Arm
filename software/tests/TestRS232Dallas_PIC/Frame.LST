  40          //******************************************************************************
  41          // Nom de la fct:   vInitPortSerie                    Fait par: Pierre Chouinard
  42          // Date:            17 Decembre 2008
  43          // Revision :       A   
  44          // Prototype:       void vInitPortSerie(void)
  45          // Description:     Cette fonction configure le port serie 0 avec timer 1
  46          //                  pour le baudrate demande, en N, 8, 1, sans interruption.
  47          // Exemple d'appel: vInitVitessePortSerie(57600,11059200);
  48          //******************************************************************************
  49          void vInitVitessePortSerie(unsigned long fVitesse, unsigned long fFreq)
  50          {
  51   1        SCON0 = 0x50;                     // Selectione mode 1, 8-bit avec reception      
  52   1        PCON  = PCON | 0x80;              // SMOD = 1 pour doubler la vitesse port serie 
  53   1        TMOD  = TMOD & 0x0F;              // timer 1, en timer mode 2, 
  54   1        TMOD  = TMOD | 0x20;              // 8-bit auto-reload        
  55   1        TH1   = (char) 256-(fFreq/16/12/fVitesse); // a 11.0592MHz: avec SMOD = 1
C51 COMPILER V9.53.0.0   FRAME                                                             11/29/2023 15:42:33 PAGE 2   

  56   1                                                   // FA=9600,
  57   1                                                   //FD=19200, FE=28800 et FF=57600    
  58   1        TR1   = 1;                        // Active le timer 1                          
  59   1        TI_0  = 1;                        // Met TI a 1 pour un premier charactere    
  60   1      }// Fin --- vInitPortSerie()


