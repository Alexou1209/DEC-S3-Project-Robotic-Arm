0027   30FF           00199      movlw   b'11111111'        ; Remplacer les x par des 1 ou 0.
0028   0085           00200      movwf   TRISA              ; PortA en entree         
0029   30E4           00201      movlw   b'11100100'        ; Bits en entrées sauf,
