01BA   2???           00276     call    StartBitI2C
01BB   30A0           00277     movlw   0xA0
01BC   00AE           00278     movwf   vOctet
01BD   2???           00279     call    Ecrire8BitsI2C
                      00280     
01BE   0830           00281     movfw   vAddH
01BF   00AE           00282     movwf   vOctet
01C0   2???           00283     call    Ecrire8BitsI2C
                      00284     
01C1   0831           00285     movfw   vAddB
01C2   00AE           00286     movwf   vOctet
