                      00001 ;********************************** SDA SCL ***********************************
                      00002 ;
                      00003 ; Gestion de SDA et SCL pour ne jamais mettre de vrai 1 sur le bus. C'est les 
                      00004 ; pull-up sur SDA et SCL qui s'en charge.
                      00005 ;
                      00006 ; Pour mettre SDA ou SCL à 1 on met le bit en entree.
                      00007 ;
                      00008 ;******************************************************************************
0161                  00009 SDA0     
0161   1086           00010      bcf     SDA               ; On s'assure que bit du latch est a 0.
0162   1683           00011      BANK1
0163   1086           00012      bcf     TRISB,1           ; SDA en output met bit a 0.
0164   1283           00013      BANK0
0165   0008           00014      return
                      00015 ; fin routine SDA0 ------------------------------------------------------------
                      00016 
                      00017 ;******************************************************************************      
0166                  00018 SDA1 
0166   1683           00019      BANK1
0167   1486           00020      bsf     TRISB,1           ; SDA input (pull-up met a 1 ).
0168   1283           00021      BANK0
0169   0008           00022      return  
                      00023 ; fin routine SDA1 ------------------------------------------------------------
                      00024 
                      00025 ;******************************************************************************
016A                  00026 SCL0 
016A   1006           00027      bcf     SCL               ; On s'assure que le bit du latch est a 0.
016B   1683           00028      BANK1
016C   1006           00029      bcf     TRISB,0           ; SCL en output met bit a 0.
016D   1283           00030      BANK0
016E   0008           00031      return
                      00032 ; fin routine SCL0 ------------------------------------------------------------
                      00033 
                      00034 ;******************************************************************************         
016F                  00035 SCL1 
