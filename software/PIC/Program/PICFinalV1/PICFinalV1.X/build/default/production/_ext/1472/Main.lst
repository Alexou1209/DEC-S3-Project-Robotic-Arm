                      00172 ;******************************* InitPic **************************************
                      00173 ;       Nom de la fonction : InitPic                    
                      00174 ;       Auteur : Alain Champagne
                      00175 ;       Date de creation : 23-09-2018                                
                      00176 ;       Description :      Routine d'initiation des registres du PIC.
                      00177 ;                          - RP1 à 0 pour être toujours dans Bank 0 et 1,
                      00178 ;                          - Désactiver les interruptions,
                      00179 ;                          - Désactiver les entrées analogiques,
                      00180 ;                          - PortA en entrée,
                      00181 ;                          - PortB en entrée sauf: Bits I2C et LEDs en sortie.
                      00182 ;                                                       
                      00183 ;       Fonctions appelees : NA 
                      00184 ;       Paramètres d'entree : NA  
                      00185 ;       Paramètres de sortie : NA 
                      00186 ;       Variables utilisees : NA  
                      00187 ;       Include : Fichier P16F88.inc
                      00188 ;       Equates : NA
                      00189 ;       #Defines : BANK0, BANK1 
                      00190 ;                                               
                      00191 ;******************************************************************************
0021                  00192 InitPic
0021   1303           00193      bcf     STATUS, RP1        ; Pour s'assurer d'être dans les bank 0 et 1 
0022   1683           00194      BANK1                      ; Select Bank1        
0023   138B           00195      bcf     INTCON,GIE         ; Désactive les interruptions        
