007C   3090           00019     movlw   b'10010000';     Set reception sur port serie SPEN=CREN = 1
007D   0098           00020     movwf   RCSTA;       
007E   1683           00021     BANK1;       
007F   3024           00022     movlw   b'00100100';     Set la transmission sur le port serie
