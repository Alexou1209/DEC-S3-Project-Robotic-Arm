                      00318 ;****************************** Interruption **********************************
002E                  00319 Interruption
                      00320 
                      00321 ;    movwf     w_temp         ; save off current W register contents
                      00322 ;    movf      STATUS,w       ; move STATUS register into W register
                      00323 ;    movwf     status_temp    ; save off contents of STATUS register
                      00324 ;    movf      PCLATH,W       ; move PCLATH register into W register
                      00325 ;    movwf     pclath_temp    ; save off contents of PCLATH register
                      00326 
                      00327 ; isr code can go here or be located as a call subroutine elsewhere
                      00328 
                      00329 
                      00330 ;    movf      pclath_temp,w  ; retrieve copy of PCLATH register
                      00331 ;    movwf     PCLATH         ; restore pre-isr PCLATH register contents
                      00332 ;    movf      status_temp,w  ; retrieve copy of STATUS register
                      00333 ;    movwf     STATUS         ; restore pre-isr STATUS register contents
                      00334 ;    swapf     w_temp,f
                      00335 ;    swapf     w_temp,w       ; restore pre-isr W register contents
002E   0009           00336     retfie                   ; return from interrupt
