                      00231 ;                                               
                      00232 ;******************************************************************************
001E                  00233 LectureADC
001E   1683           00234      BANK1
001F   081E           00235      movf    ADRESL, w
0020   00A1           00236      movwf   vADCL
0021   1283           00237      BANK0
