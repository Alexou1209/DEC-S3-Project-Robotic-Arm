                      00126 ;******************************* InitPic **************************************
                      00127 ;       Nom de la fonction : InitPic                    
                      00128 ;       Auteur : Alain Champagne
                      00129 ;       Date de creation : 23-09-2018                                
                      00130 ;       Description :      Routine d'initiation des registres du PIC.
                      00131 ;                          - RP1 à 0 pour être toujours dans Bank 0 et 1,
                      00132 ;                          - Désactiver les interruptions,
                      00133 ;                          - Désactiver les entrées analogiques,
                      00134 ;                          - PortA en entrée,
                      00135 ;                          - PortB en entrée sauf: Bits I2C et LEDs en sortie.
                      00136 ;                                                       
                      00137 ;       Fonctions appelees : NA 
                      00138 ;       Paramètres d'entree : NA  
                      00139 ;       Paramètres de sortie : NA 
                      00140 ;       Variables utilisees : NA  
                      00141 ;       Include : Fichier P16F88.inc
                      00142 ;       Equates : NA
                      00143 ;       #Defines : BANK0, BANK1 
                      00144 ;                                               
                      00145 ;******************************************************************************
0007                  00146 InitPic
0007   1303           00147      bcf     STATUS, RP1       ; Pour s'assurer d'être dans les bank 0 et 1 
0008   1683           00148      BANK1                     ; Select Bank1        
0009   138B           00149      bcf     INTCON,GIE        ; Désactive les interruptions        
000A   019B           00150      clrf    ANSEL             ; Désactive les convertisseurs reg ANSEL 0x9B        
000B   3078           00151      movlw   b'01111000'       ; osc internal 8 Mhz
000C   008F           00152      movwf   OSCCON
000D   30FF           00153      movlw   b'11111111'       ; Remplacer les x par des 1 ou 0.
000E   0085           00154      movwf   TRISA             ; PortA en entree         
000F   30E7           00155      movlw   b'11100111'       ; Bits en entrées sauf,
MPASM 5.87                        ADCPIC.ASM   11-28-2023  14:03:44         PAGE  4


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0010   0086           00156      movwf   TRISB             ; RB3 (Led1), RB4 (Led2) en sortie. 
0011   1283           00157      BANK0                     ; Select Bank0
0012   0008           00158      return
                      00159 
                      00160 ; fin routine InitPic ---------------------------------------------------------
                      00161 
                      00162 
                      00163      
                      00164 ;******************************* InitADC **************************************
                      00165 ;       Nom de la fonction : InitADC                   
                      00166 ;       Auteur : Félix Tremblay
                      00167 ;       Date de creation : 23-11-28                              
                      00168 ;       Description : Fonction d'initialisation de l'ADC. 
                      00169 ;                     Le bit A0 du PortA est pour etre convertit, de base.
                      00170 ;
                      00171 ;                                                       
                      00172 ;       Fonctions appelees : NA 
                      00173 ;       Paramètres d'entree : NA  
                      00174 ;       Paramètres de sortie : NA 
                      00175 ;       Variables utilisees : NA  
                      00176 ;       Include : Fichier P16F88.inc
                      00177 ;       Equates : NA
                      00178 ;       Define : Aucun 
                      00179 ;                                               
                      00180 ;******************************************************************************
0013                  00181 InitADC
0013   1683           00182      BANK1
0014   3007           00183      movlw   b'00000111'
0015   009B           00184      movwf   ANSEL
0016   30C0           00185      movlw   b'11000000'
0017   009F           00186      movwf   ADCON1
0018   1283           00187      BANK0
0019   3081           00188      movlw   b'10000001'
001A   009F           00189      movwf   ADCON0
001B   0008           00190      return 
                      00191 ; fin routine InitADC ---------------------------------------------------------
                      00192      
                      00193      
