                      00001 ;********************************** SDA SCL ***********************************
                      00002 ;
                      00003 ; Gestion de SDA et SCL pour ne jamais mettre de vrai 1 sur le bus. C'est les 
                      00004 ; pull-up sur SDA et SCL qui s'en charge.
                      00005 ;
                      00006 ; Pour mettre SDA ou SCL à 1 on met le bit en entree.
                      00007 ;
                      00008 ;******************************************************************************
009D                  00009 SDA0     
009D   1086           00010      bcf     SDA               ; On s'assure que bit du latch est a 0.
009E   1683           00011      BANK1
009F   1086           00012      bcf     TRISB,1           ; SDA en output met bit a 0.
