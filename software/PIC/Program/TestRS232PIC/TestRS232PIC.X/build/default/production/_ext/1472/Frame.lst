                      00361 ;       Date de creation : 23-09-2018                                
                      00362 ;       Description :      Routine d'initiation des registres du PIC.
                      00363 ;                          - RP1 à 0 pour être toujours dans Bank 0 et 1,
                      00364 ;                          - Désactiver les interruptions,
                      00365 ;                          - Désactiver les entrées analogiques,
                      00366 ;                          - PortA en entrée,
                      00367 ;                          - PortB en entrée sauf: Bits I2C et LEDs en sortie.
                      00368 ;                                                       
                      00369 ;       Fonctions appelees : NA 
                      00370 ;       Paramètres d'entree : NA  
                      00371 ;       Paramètres de sortie : NA 
                      00372 ;       Variables utilisees : NA  
                      00373 ;       Include : Fichier P16F88.inc
                      00374 ;       Equates : NA
                      00375 ;       #Defines : BANK0, BANK1 
                      00376 ;                                               
                      00377 ;******************************************************************************
007F                  00378 InitPic
007F   1303           00379      bcf     STATUS, RP1       ; Pour s'assurer d'être dans les bank 0 et 1 
0080   1683           00380      BANK1                     ; Select Bank1        
0081   138B           00381      bcf     INTCON,GIE        ; Désactive les interruptions        
0082   019B           00382      clrf    ANSEL             ; Désactive les convertisseurs reg ANSEL 0x9B        
0083   3078           00383      movlw   b'01111000'       ; osc internal 8 Mhz
0084   008F           00384      movwf   OSCCON
0085   30FF           00385      movlw   b'11111111'       ; Remplacer les x par des 1 ou 0.
0086   0085           00386      movwf   TRISA             ; PortA en entree         
0087   30E4           00387      movlw   b'11100100'       ; Bits en entrées sauf,
0088   0086           00388      movwf   TRISB             ; RB3 (Led1), RB4 (Led2) en sortie. 
0089   1283           00389      BANK0                     ; Select Bank0
008A   0008           00390      return
                      00391 ; fin routine InitPic ---------------------------------------------------------
                      00392 #include <FonctionsRS-232.asm>
