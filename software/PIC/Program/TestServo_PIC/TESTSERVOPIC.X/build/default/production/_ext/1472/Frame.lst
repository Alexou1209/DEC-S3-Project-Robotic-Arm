                      00095 ;******************************* Lire1BitI2C **********************************
                      00096 ;       Nom de la fonction : Lire1BitI2C                        
                      00097 ;       Auteur :             
                      00098 ;       Date de creation :                           
                      00099 ;       Modification :  
                      00100 ;       Description :   Routine de reception d'un bit de communication I2C.
                      00101 ;                       La routine prend le bit de la ligne SDA après avoir 
                      00102 ;                       active la ligne SCL. Le bit de donnee est place 
                      00103 ;                       temporairement dans la variable ___________ et sera  
                      00104 ;                       reutilise dans la routine de traitement d'octets.
                      00105 ;                                                       
                      00106 ;       Fonctions appelees :          
                      00107 ;       Paramètres d'entree :             
                      00108 ;       Paramètres de sortie :               
                      00109 ;       Variables utilisees :  
                      00110 ;       Include :    
                      00111 ;       Equate :                 
                      00112 ;       #Define :         
                      00113 ;                                               
                      00114 ;******************************************************************************
002F                  00115 Lire1BitI2C
002F   2???           00116     call    SCL0
0030   2???           00117     call    SDA1
0031   2???           00118     call    SCL1
0032   2???           00119     call    Delai5us
0033   1C86           00120     btfss   SDA
0034   2???           00121     goto    Lu0
0035   2???           00122     goto    Lu1
0036                  00123 Lu1
0036   1420           00124     bsf     BITSDA
0037   2???           00125     goto    FinLire1Bit
MPASM 5.87                         FRAME.ASM   11-30-2023  20:15:42         PAGE  7


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0038                  00126 Lu0
0038   1020           00127     bcf     BITSDA
0039                  00128 FinLire1Bit
0039   2???           00129     call    SCL0
003A   0008           00130     return
                      00131 ; fin routine Lire1BitI2C------------------------------------------------------
