                      00042 ;****************************** StartBitI2C ***********************************
                      00043 ;       Nom de la fonction : StartBitI2C                       
                      00044 ;       Auteur : Naomie Dion                
                      00045 ;       Date de creation : 02-11-2023                                
                      00046 ;       Modification : 
                      00047 ;       Description :   Routine d'initiation d'une communication serie I2C. 
                      00048 ;                       Doit être appelee à chaque debut d'operation.
                      00049 ;                       Le passage de 1 à 0 sur la ligne SDA durant
                      00050 ;                       un niveau 1 sur la ligne SCL initie un START BIT.
                      00051 ;                                                       
                      00052 ;       Fonctions appelees : SDA0/1 et SCL0/1           
                      00053 ;       Paramètres d'entree :            
                      00054 ;       Paramètres de sortie :            
                      00055 ;       Variables utilisees : 
                      00056 ;       Include :    
                      00057 ;       Equate :                   
                      00058 ;       #Define :                    
                      00059 ;                                               
                      00060 ;******************************************************************************
0025                  00061 StartBitI2C
0025   2???           00062     call    SDA1
0026   2???           00063     call    SCL1
0027   2???           00064     call    SDA0
0028   2???           00065     call    SCL0
0029   0008           00066     return
                      00067 ; fin routine StartBitI2C------------------------------------------------------
                      00068 
