                      00133 ;****************************** Ecrire1BitI2C *********************************
                      00134 ;       Nom de la fonction : Ecrire1BitI2C                      
                      00135 ;       Auteur :                 
                      00136 ;       Modification :  
                      00137 ;       Date de creation :                           
                      00138 ;       Description : Routine d'emission d'un bit de communication I2C.
                      00139 ;                     La routine utilise le bit 0 de la variable _____________ 
                      00140 ;                     pour ajuster le niveau de la ligne SDA.  
                      00141 ;                     Les lignes SDA et SCL sont activee à tour de rôle pour 
                      00142 ;                     communiquer l'information du maître à l'esclave.
                      00143 ;                                                       
                      00144 ;       Fonctions appelees :          
                      00145 ;       Paramètres d'entree :                  
                      00146 ;       Paramètres de sortie :          
                      00147 ;       Variables utilisees : 
                      00148 ;       Include :    
                      00149 ;       Equate :                 
                      00150 ;       #Define :                 
                      00151 ;                                               
                      00152 ;******************************************************************************
003B                  00153 Ecrire1BitI2C
003B   2???           00154     call    SCL0
003C   2???           00155     call    Delai5us
003D   1820           00156     btfsc   BITSDA
003E   2???           00157     goto    Ecrit1 
003F   2???           00158     goto    Ecrit0
0040                  00159 Ecrit0
0040   2???           00160     call    SDA0
0041   2???           00161     goto    FinEcrire1Bit    
0042                  00162 Ecrit1
0042   2???           00163     call    SDA1
0043                  00164 FinEcrire1Bit
0043   2???           00165     call    SCL1
0044   2???           00166     call    Delai5us
0045   2???           00167     call    SCL0
0046   0008           00168     return 
                      00169 ; fin routine Ecrire1BitI2C----------------------------------------------------
