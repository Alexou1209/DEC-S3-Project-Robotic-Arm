                      00149 ;       Date de creation : 23-09-2018                                
                      00150 ;       Description :      Routine d'initiation des registres du PIC.
                      00151 ;                          - RP1 à 0 pour être toujours dans Bank 0 et 1,
                      00152 ;                          - Désactiver les interruptions,
                      00153 ;                          - Désactiver les entrées analogiques,
                      00154 ;                          - PortA en entrée,
                      00155 ;                          - PortB en entrée sauf: Bits I2C et LEDs en sortie.
                      00156 ;                                                       
                      00157 ;       Fonctions appelees : NA 
                      00158 ;       Paramètres d'entree : NA  
                      00159 ;       Paramètres de sortie : NA 
                      00160 ;       Variables utilisees : NA  
                      00161 ;       Include : Fichier P16F88.inc
                      00162 ;       Equates : NA
                      00163 ;       #Defines : BANK0, BANK1 
                      00164 ;                                               
                      00165 ;******************************************************************************
0007                  00166 InitPic
0007   1303           00167      bcf     STATUS, RP1       ; Pour s'assurer d'être dans les bank 0 et 1 
0008   1683           00168      BANK1                     ; Select Bank1        
0009   138B           00169      bcf     INTCON,GIE        ; Désactive les interruptions        
000A   019B           00170      clrf    ANSEL             ; Désactive les convertisseurs reg ANSEL 0x9B        
000B   3078           00171      movlw   b'01111000'       ; osc internal 8 Mhz
000C   008F           00172      movwf   OSCCON
000D   30FF           00173      movlw   b'11111111'       ; Remplacer les x par des 1 ou 0.
000E   0085           00174      movwf   TRISA             ; PortA en entree         
000F   30E4           00175      movlw   b'11100100'       ; Bits en entrées sauf,
0010   0086           00176      movwf   TRISB             ; RB3 (Led1), RB4 (Led2) en sortie. 
0011   1283           00177      BANK0                     ; Select Bank0
0012   0008           00178      return
                      00179 ; fin routine InitPic ---------------------------------------------------------
                      00180 
                      00181 ;#include <FonctionsRS-232.asm>
                      00182 #include <FonctionsI2C.asm>
                      00001 ;********************************** SDA SCL ***********************************
                      00002 ;
                      00003 ; Gestion de SDA et SCL pour ne jamais mettre de vrai 1 sur le bus. C'est les 
                      00004 ; pull-up sur SDA et SCL qui s'en charge.
                      00005 ;
                      00006 ; Pour mettre SDA ou SCL à 1 on met le bit en entree.
                      00007 ;
                      00008 ;******************************************************************************
0013                  00009 SDA0     
0013   1086           00010      bcf     SDA               ; On s'assure que bit du latch est a 0.
0014   1683           00011      BANK1
0015   1086           00012      bcf     TRISB,1           ; SDA en output met bit a 0.
0016   1283           00013      BANK0
0017   0008           00014      return
                      00015 ; fin routine SDA0 ------------------------------------------------------------
                      00016 
                      00017 ;******************************************************************************      
0018                  00018 SDA1 
0018   1683           00019      BANK1
MPASM 5.87                         FRAME.ASM   11-30-2023  20:15:42         PAGE  5


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

0019   1486           00020      bsf     TRISB,1           ; SDA input (pull-up met a 1 ).
001A   1283           00021      BANK0
001B   0008           00022      return  
                      00023 ; fin routine SDA1 ------------------------------------------------------------
                      00024 
                      00025 ;******************************************************************************
001C                  00026 SCL0 
001C   1006           00027      bcf     SCL               ; On s'assure que le bit du latch est a 0.
001D   1683           00028      BANK1
001E   1006           00029      bcf     TRISB,0           ; SCL en output met bit a 0.
001F   1283           00030      BANK0
0020   0008           00031      return
                      00032 ; fin routine SCL0 ------------------------------------------------------------
                      00033 
                      00034 ;******************************************************************************         
0021                  00035 SCL1 
0021   1683           00036      BANK1
0022   1406           00037      bsf     TRISB,0           ; SCL input (pull-up met a 1 ).
0023   1283           00038      BANK0
0024   0008           00039      return 
                      00040 ; fin routine SCL1 ------------------------------------------------------------  
