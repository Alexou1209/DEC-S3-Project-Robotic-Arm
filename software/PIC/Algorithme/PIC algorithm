vOctet8
endc

;Pour permettre les interruptions de réception sur le port série.
BANK1 
bsf  INTCON, PEIE ; Autorise les interruptions de périphériques.
bsf  PIE1  , RCIE ; Autorise les interruptions sur réception série.
BANK0
bsf  INTCON, GIE  ; Autorise les interruptions globales.

;Routine d'interruption
SI (PIR1, RCIF == 1)
  Lire le caractère
  PIR1, RCIF = 0 
  FSR = ( ( vIndiceIN&0x07) + Position en mémoire de la trame)
  Écrire en mémoire le caractère reçu
  vIndiceIN = (vIndiceIN + 1) & 0x07)
FIN SI

;Buffer circulaire

Si (vIndiceIN != vIndiceOUT)
  Switch (vIndiceTrame)
    Case 0 
      LireChar1
    Break
    Case 1 
      LireChar2
    Break
	Case 2 
      LireChar3
    Break
	Case 3 
      LireChar4
    Break
	Case 4 
      LireChar5
    Break
	Case 5 
      LireChar6
    Break
	Case 6 
      LireChar7
    Break
    Case 7 
      LireChar8
    Break
	
  LireChar1
  Initialiser FSR avec (vIndiceOUT + Position mémoire de la trame)
  vRecu = Lire la case mémoire avec registre INDF
  vIndiceOUT = ((vIndiceOUT + 1) & 0x07)
  Effacer la case mémoire
  Si (vRecu == ‘G’)
    vIndiceTrame = ((vIndiceTrame + 1) & 0x07)
  FIN SI
  
  LireChar2
  Initialiser FSR avec (vIndiceOUT + Position mémoire de la trame)
  vRecu = Lire la case mémoire
  vIndiceOUT = ((vIndiceOUT + 1) & 0x07)
  Effacer la case mémoire
  Si (vRecu == ‘O’)
    vIndiceTrame = ((vIndiceTrame + 1) & 0x07)
  FIN SI  
  
  LireChar3
  Initialiser FSR avec (vIndiceOUT + Position mémoire de la trame)
  vMoteur0 = Lire la case mémoire
  vIndiceOUT = ((vIndiceOUT + 1) & 0x07)
  vIndiceTrame = ((vIndiceTrame + 1) & 0x07)

