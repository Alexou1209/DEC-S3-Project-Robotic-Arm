 500          // *************************************************************************************************
 501          void vTraiteSequence(unsigned char *ucEtatSequence, unsigned char *ucSequence, unsigned char *ucStep)
 502          //
 503          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 504          //  Date de création : 9 decembre 2023 
 505          //  Version 1.0
 506          //
 507          //  Description: 
 508          //  Paramètres d'entrées : l'etat de la sequence, la sequence actuelle, le step actuel 
 509          //  Paramètres de sortie : Aucun
