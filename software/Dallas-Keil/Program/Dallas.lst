 395          // *************************************************************************************************
 396          void vAfficheEtat(struct STState *pstState, unsigned char ucSequence, unsigned char ucStep)
 397          //
 398          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 399          //  Date de création : 9 decembre 2023  
 400          //  Version 1.0
 401          //
 402          //  Description: Fonction qui affiche la valeurs des moteurs, les valeurs de la balance, de la pince
 403          //                               et du pave tactile, lues par le pic, la grosseur du poids, la valeur de l'increment 
 404          //                               des moteurs en mode manuel, la sequence actuelle, le step actuel et l'etat de la 
 405          //                               transmission
 406          //  Paramètres d'entrées : pointeur de la structure STState, la sequence actuelle, le step actuel 
 407          //  Paramètres de sortie : Aucun
 408          //  Notes                    : Aucune
 409          //
 410          // *************************************************************************************************
 411          {
 412   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucBase/16), LIGNE0, 2);             // Valeur de la Base
 413   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucBase%16), LIGNE0, 3);
 414   1              
 415   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucEpaule/16), LIGNE0, 7);   // Valeur de l'Epaule
 416   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucEpaule%16), LIGNE0, 8);
 417   1              
 418   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucCoude/16), LIGNE0, 12);   // Valeur du Coude
 419   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucCoude%16), LIGNE0, 13);
 420   1              
 421   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucPoignet/16), LIGNE0, 17); // Valeur du Poignet
 422   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucPoignet%16), LIGNE0, 18);
 423   1              
 424   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucPince/16), LIGNE1, 2);    // Valeur de la Pince
 425   1              vLCDEcrireCaract(ucConvHextoASCII(pstState->ucPince%16), LIGNE1, 3);
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 8   

 426   1                      
 427   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet2/16), LIGNE1, 7); // Valeur pos X sur le pave
 428   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet2%16), LIGNE1, 8);
 429   1              
 430   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet3/16), LIGNE1, 12);// Valeur pos Y sur le pave     
 431   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet3%16), LIGNE1, 13);
 432   1              
 433   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet4/16), LIGNE1, 17);// Valeur capteur de la pince
 434   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet4%16), LIGNE1, 18);
 435   1              
 436   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet5/16), LIGNE2, 2); // Valeur de la balance
 437   1              vLCDEcrireCaract(ucConvHextoASCII(stReception.ucOctet5%16), LIGNE2, 3);
 438   1              
 439   1              switch(ucBloc)                          // Affiche la grosseur du bloc selon le cas 
 440   1              {
 441   2                      case AUCUN:
 442   2                        vLCDEcrireCaract('-', LIGNE2, 10);            // Affiche aucun
 443   2                        vLCDEcrireCaract('-', LIGNE2, 11);
 444   2                      break;
 445   2                      
 446   2                      case PETIT: 
 447   2                    vLCDEcrireCaract('P', LIGNE2, 10);                // Affiche Petit
 448   2                        vLCDEcrireCaract('e', LIGNE2, 11);            
 449   2                      break;
 450   2                      
 451   2                      case MOYEN: 
 452   2                        vLCDEcrireCaract('M', LIGNE2, 10);            // Affiche Moyen
 453   2                        vLCDEcrireCaract('o', LIGNE2, 11);
 454   2                      break;
 455   2                      
 456   2                      case GROS: 
