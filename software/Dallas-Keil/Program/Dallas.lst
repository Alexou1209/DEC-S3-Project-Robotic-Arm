  21          // *************************************************************************************************
  22          void vTraiteTouche(unsigned char ucTouche, struct STState *pstState, unsigned char *ucSequence,
  23                                         unsigned char *ucEtatSequence, unsigned char *ucStep)
  24          //
  25          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
  26          //  Date de création : 9 decembre 2023 
  27          //  Version 1.0
  28          //
  29          //  Description: Fonction traitant les touches appuyer sur le clavier I2C et effectue les actions en conse
             -quence.
  30          //  Paramètres d'entrées : Touche appuyer sur le clavier I2C, pointeur de la structure STState, 
  31          //                                                 la sequence actuelle, le step actuel 
  32          //  Paramètres de sortie : Aucun
  33          //  Notes                    : Aucune
  34          //
  35          // *************************************************************************************************
  36          {
  37   1              switch(ucTouche)
  38   1              {
  39   2                      case '1' :                                              // Changement des moteur selectionnes
  40   2                    ucNumMoteur = BASE;                               
  41   2                      break;
  42   2                      case '2' :
  43   2                        ucNumMoteur = EPAULE;                 //
  44   2                      break;
  45   2                      case '3' :                 
  46   2                        ucNumMoteur = COUDE;                  //
  47   2                      break;
  48   2                      case '4' :                  
  49   2                    ucNumMoteur = POIGNET;            //
  50   2                      break;
  51   2                      case '5' :                 
  52   2                        ucNumMoteur = PINCE;                  // Changement des moteurs selectionnes
  53   2                      break;
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 2   

  54   2                      case '0' :                              // Changement de l'incrementation
  55   2                      if(ucIncrement < 17)
  56   2                      {
  57   3                ucIncrement = ucIncrement +4;
  58   3              }
  59   2              else
  60   2              {                       
  61   3                        ucIncrement = 1;
  62   3                      }
  63   2                      break;
  64   2                      case '*' :                                              // Diminue la valeur du moteur selectionne               
  65   2                        vDecMouvement(pstState);
  66   2                      break;
  67   2                      case '#' :                                      // Augmente la valeur du moteur selectionne
  68   2                        vIncMouvement(pstState);                                      
  69   2                      break;
  70   2                      
  71   2                      case 'A' :                                               // Echauffement du bras ou remise au repos      
  72   2                        if(*ucEtatSequence == NONACTIVE)      // Evite d'enclencher les sequences de repos et d'echauffement
  73   2                        {                                                                     // durant une autre sequence 
  74   3                          if(bEchauffementFait == NONFAIT)             
  75   3                          {
  76   4                                *ucSequence = 7;                              // Sequence d'echauffement 
  77   4                            *ucEtatSequence = ACTIVE;  
  78   4                                bEchauffementFait = FAIT;
  79   4                                ucTouche = ESPACE;                    // Reset ucTouche pour eviter de retourner directement dans le else 
  80   4                          }
  81   3                          else 
  82   3                          {
  83   4                                *ucSequence = 8;                              // Sequence de retour au repos 
  84   4                                *ucEtatSequence = ACTIVE;
  85   4                                bEchauffementFait = NONFAIT;
  86   4                          }  
  87   3                        }
  88   2                      break;
  89   2                                                
  90   2                      case 'B':                                                       // Permet de positionner le bras en position attente
  91   2                    if(*ucEtatSequence == NONACTIVE)  // si Aucune sequence en cours 
  92   2                        {
  93   3                          if(bEchauffementFait == FAIT)       // Si le bras n'est pas au repos 
  94   3                              {
  95   4                                      *ucSequence = 7;                        // Retour position attente 
  96   4                                      *ucStep = 8;
  97   4                                      *ucEtatSequence = ACTIVE;
  98   4                              }
  99   3                        }
 100   2                      break;
 101   2              }
 102   1      }
