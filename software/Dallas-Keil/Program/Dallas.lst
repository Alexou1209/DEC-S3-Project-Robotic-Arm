 333          // *************************************************************************************************
 334          void vEnvoieTrame(struct STState *pstState)
 335          //
 336          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 337          //  Date de création : 9 decembre 2023
 338          //  Version 1.0
 339          //
 340          //  Description: Fonction qui envoie les valeurs des moteurs au pic 
 341          //  Paramètres d'entrées : pointeur de la structure STState
 342          //  Paramètres de sortie : Aucun
 343          //  Notes                      : Aucune
 344          //
 345          // *************************************************************************************************
 346          {
 347   1              unsigned char ucCheckSum = 0;
 348   1              
 349   1              
 350   1              ES0 = 0;                                                                                        // Desactive Interrupt RS232 pour eviter que 
 351   1                                                                                                                      // la transmission cause interrupt non voulu    
 352   1              SBUF0 = 'G';                                                                            // Envoie du 'G'
 353   1              ucCheckSum = ucCheckSum + 'G';                                          // Addition du CheckSum
 354   1              while(!TI_0);                                           
 355   1              TI_0 = 0;
 356   1              
 357   1              SBUF0 = 'O';                                                                            // Envoie du 'O'
 358   1              ucCheckSum = ucCheckSum + 'O';          
 359   1              while(!TI_0);    
 360   1              TI_0 = 0;
 361   1              
 362   1              SBUF0 = pstState->ucBase;                                                       // Envoie la valeur de la Base
 363   1              ucCheckSum = ucCheckSum + pstState->ucBase;
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 7   

 364   1              while(!TI_0);    
 365   1              TI_0 = 0;
 366   1              
 367   1              SBUF0 = pstState->ucEpaule;                                                     // Envoie la valeur de l'Epaule
 368   1              ucCheckSum = ucCheckSum + pstState->ucEpaule;
 369   1              while(!TI_0);    
 370   1              TI_0 = 0;
 371   1              
 372   1              SBUF0 = pstState->ucCoude;                                                      // Envoie la valeur du Coude
 373   1              ucCheckSum = ucCheckSum + pstState->ucCoude;
 374   1              while(!TI_0);    
 375   1              TI_0 = 0;
 376   1                      
 377   1              SBUF0 = pstState->ucPoignet;                                            // Envoie la valeur du Poignet
 378   1              ucCheckSum = ucCheckSum + pstState->ucPoignet;
 379   1              while(!TI_0);    
 380   1              TI_0 = 0;
 381   1              
 382   1              SBUF0 = pstState->ucPince;                                                      // Envoie la valeur de la Pince
 383   1              ucCheckSum = ucCheckSum + pstState->ucPince;    
 384   1              while(!TI_0);    
 385   1              TI_0 = 0;
 386   1              
 387   1              SBUF0 = ucCheckSum;                                                                     // Envoie du CheckSum
 388   1              while(!TI_0);    
 389   1              TI_0 = 0;
 390   1              
 391   1              ES0 = 1;                                                                                        // Reactive Interrupt RS232
 392   1      }
