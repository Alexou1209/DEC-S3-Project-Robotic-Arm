 470          // *************************************************************************************************
 471          unsigned char ucConvHextoASCII(unsigned char ucHex)
 472          //
 473          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 474          //  Date de création : 9 decembre 2023
 475          //  Version 1.0
 476          //
 477          //  Description: Fonction qui convertit un chiffre hexadecimal ou decimal en code ASCII pour l'afficher  
 478          //                               sur l'ecran LCD de la Dallas
 479          //  Paramètres d'entrées : Valeur en hexadicimal ou decimal, ucHex
 480          //  Paramètres de sortie : Lettre ou chiffre en hexadecimal de la valeur convertit 
 481          //  Notes                    : Aucune
 482          //
 483          // *************************************************************************************************
 484          {
 485   1              unsigned char ucASCII;
 486   1              
 487   1              if(ucHex >= 0 && ucHex <= 9)            // Ajoute 0x30 au chiffre a convertir pour 
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 9   

 488   1              {                                                                       // acceder au chiffre 0 a 9 ASCII
 489   2                ucASCII = ucHex + 0x30;                       
 490   2              }
 491   1              
 492   1              if(ucHex >= 10 && ucHex <= 15)          // Ajoute 0x37 au chiffre a convertir pour 
 493   1              {                                                                       // acceder au lettre A a F ASCII
 494   2            ucASCII = ucHex + 0x37;
 495   2              }
 496   1              return(ucASCII);
 497   1      }
