 458   2                        vLCDEcrireCaract('r', LIGNE2, 11);
 459   2                      break;
 460   2              }
 461   1              
 462   1              vLCDEcrireCaract(ucConvHextoASCII(ucIncrement/16), LIGNE3, 0);                  // Valeur de l'increment
 463   1              vLCDEcrireCaract(ucConvHextoASCII(ucIncrement%16), LIGNE3, 1);
 464   1              
 465   1              vLCDEcrireCaract(ucConvHextoASCII(ucSequence%16), LIGNE3, 7);                   // Sequence actuelle
 466   1              
 467   1              vLCDEcrireCaract(ucConvHextoASCII(ucStep%16), LIGNE3, 14);                              // Step actuel
 468   1      }
