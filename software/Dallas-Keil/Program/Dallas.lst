 695          //******************************************************************************
 696          // Nom de la fct:   vInitPortSerie                    Fait par: Pierre Chouinard
 697          // Date:            17 Decembre 2008
 698          // Revision :       A           
 699          // Prototype:       void vInitPortSerie(void)
 700          // Description:     Cette fonction configure le port serie 0 avec timer 1
 701          //                  pour le baudrate demande, en N, 8, 1, sans interruption.
 702          // Exemple d'appel: vInitVitessePortSerie(57600,11059200);
 703          //******************************************************************************
 704          void vInitVitessePortSerie(unsigned long fVitesse, unsigned long fFreq)
 705          {
 706   1        SCON0 = 0x50;                     // Selectione mode 1, 8-bit avec reception      
 707   1        PCON  = PCON | 0x80;              // SMOD = 1 pour doubler la vitesse port serie 
 708   1        TMOD  = TMOD & 0x0F;              // timer 1, en timer mode 2, 
 709   1        TMOD  = TMOD | 0x20;              // 8-bit auto-reload        
 710   1        TH1   = (char) 256-(fFreq/16/12/fVitesse); // a 11.0592MHz: avec SMOD = 1
 711   1                                                   // FA=9600,
 712   1                                                   //FD=19200, FE=28800 et FF=57600    
 713   1        TR1   = 1;                        // Active le timer 1                          
 714   1        TI_0  = 1;                        // Met TI a 1 pour un premier charactere    
 715   1      }// Fin --- vInitPortSerie()
