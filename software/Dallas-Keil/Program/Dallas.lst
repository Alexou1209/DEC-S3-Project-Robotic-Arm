 678          void vInitTimer0(void)
 679          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 680          //  Date de création : 9 decembre 2023
 681          //
 682          //   Description : Cette fonction initialise le Timer0 en mode 16, pour lever du flag a 50ms          
 683          //   Paramètres d'entrée : Aucun.
 684          //   Paramètres de sortie : Aucun.                
 685          //   Variables utilisées : Aucun.
 686          //***************************************************************************************************
 687          {
 688   1              TMOD = (TMOD | 0x01);                                   // Mode 16 Bits
 689   1              TH0 = 0x4C;                                                             // Valeur pour 50ms
 690   1              TL0 = 0x00;
 691   1              TF0 = 0;                                                                // Clear le flag 
 692   1              TR0 = 1;                                                                // Active le Timer0
 693   1      }
