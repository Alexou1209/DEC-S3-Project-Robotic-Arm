 633          void vTraitePave(unsigned char *ucEtatSequence, unsigned char *ucSequence)
 634          //
 635          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 636          //  Date de création : 9 decembre 2023 
 637          //  Version 1.0
 638          //
 639          //  Description: Fonction qui traite les valeurs X et Y lues sur le pave tactile et effectue les actions 
 640          //                               necessaire pour nos case specifique
 641          //  Paramètres d'entrées : Etat de la sequence, la sequence actuelle 
 642          //  Paramètres de sortie : Aucun
 643          //  Notes                    : Aucune
 644          //
 645          // *************************************************************************************************
 646          {
 647   1        unsigned char ucX;
 648   1        unsigned char ucY;
 649   1              
 650   1        ucX = stReception.ucOctet2;                                                                   // Valeur X du pave 
 651   1        ucY = stReception.ucOctet3;                                                                   // Valeur Y du pave
 652   1      
 653   1              
 654   1        if(bEchauffementFait == FAIT)                                                                         // Lit les cases seulement si le                                        
 655   1        {                                                                                                                                     // bras est en position attente
 656   2          if(ucX >= 0x80 && ucX <= 0xA0 && ucY >= 0x30 && ucY <= 0x60)        // Valeur pour Case A2
 657   2          {
 658   3                *ucSequence = 0;
 659   3                *ucEtatSequence = ACTIVE;                                                                             // Active la sequence
 660   3          }
 661   2              
 662   2          if(ucX >= 0xE0 && ucX <= 0xF0 && ucY >= 0x60 && ucY <= 0x90)        // Valeur pour Case B7
 663   2          {
 664   3                *ucSequence = 1;
 665   3                *ucEtatSequence = ACTIVE;                                                                             // Active la sequence
 666   3          }
 667   2              
 668   2          if(ucX >= 0xD0 && ucX <= 0xE0 && ucY >= 0x90 && ucY <= 0xC0)        // Valeur pour Case C6
 669   2          {
 670   3                *ucSequence = 2;
 671   3            *ucEtatSequence = ACTIVE;                                                                         // Active la sequence
 672   3          }             
 673   2        }
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 12  

 674   1      }
