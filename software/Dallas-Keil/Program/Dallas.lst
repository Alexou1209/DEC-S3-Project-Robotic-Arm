 240          void vTraiteTrame(void)
 241          //
 242          //  Auteur: Felix Tremblay, Alexandre Dionne et Marie-Pier Morin        
 243          //  Date de création : 9 decembre 2023
 244          //  Version 1.0
 245          //
 246          //  Description: Fonction qui traite les donnes recues sur le port serie et les enregistres dans la 
 247          //                               structure de reception une fois ceux si verifier 
 248          //  Paramètres d'entrées : Aucun
 249          //  Paramètres de sortie : Aucun
 250          //  Notes                      : Aucune
 251          //
 252          // *************************************************************************************************
 253          {
 254   1              static unsigned char ucCompteurBuffer = 0;
 255   1              unsigned char ucOctetTemp = 0;
 256   1              static unsigned char ucCheckSum = 0;
 257   1              
 258   1              ucOctetTemp = SBUF0;                                                            // Charger le premier octet 
 259   1                      
 260   1              switch(ucCompteurBuffer)
 261   1              {
 262   2                      case 0:
 263   2                              if(ucOctetTemp == 'G')                                          // Assure d'avoir recu un 'G'
 264   2                              {
 265   3                                      stReception.ucOctet0 = ucOctetTemp;
 266   3                                      ucCheckSum = ucCheckSum + stReception.ucOctet0;
 267   3                                      ucCompteurBuffer++;     
 268   3                              }
 269   2                              else 
 270   2                              {
 271   3                                      ucCompteurBuffer = 0;                                   // Reset du buffer 
 272   3                              }
 273   2                      break;
 274   2                      
 275   2                      case 1:
 276   2                              if(ucOctetTemp == 'O')                                          // Assure d'avoir recu un 'O'
 277   2                              {
 278   3                                      stReception.ucOctet1 = ucOctetTemp;             // Enregistre la valeur dans la structure de reception
 279   3                                      ucCheckSum = ucCheckSum + stReception.ucOctet1; // Addition du ChekSum
 280   3                                      ucCompteurBuffer++;
 281   3                              }
 282   2                              else 
 283   2                              {
 284   3                                      ucCompteurBuffer = 0;                                   // Reset du buffer 
 285   3                              }
 286   2                      break;
 287   2                      
 288   2                      case 2:                                                                                 // Les commentaires sont identiques pour les autres cas
 289   2                        stReception.ucOctet2 = ucOctetTemp;
 290   2                        ucCheckSum = ucCheckSum + stReception.ucOctet2;
 291   2                        ucCompteurBuffer++;
 292   2                      break;
 293   2                      
 294   2                      case 3:
 295   2                        stReception.ucOctet3 = ucOctetTemp;
 296   2                        ucCheckSum = ucCheckSum + stReception.ucOctet3;
 297   2                        ucCompteurBuffer++;
 298   2                      break;
 299   2                      
 300   2                      case 4:
 301   2                        stReception.ucOctet4 = ucOctetTemp;
C51 COMPILER V9.53.0.0   DALLAS                                                            12/18/2023 17:45:42 PAGE 6   

 302   2                        ucCheckSum = ucCheckSum + stReception.ucOctet4;
 303   2                        ucCompteurBuffer++;
 304   2                      break;
 305   2                      
 306   2                      case 5:
 307   2                    stReception.ucOctet5 = ucOctetTemp;
 308   2                        ucCheckSum = ucCheckSum + stReception.ucOctet5;
 309   2                        ucCompteurBuffer++;
 310   2                      break;
 311   2                      
 312   2                      case 6:
 313   2                    stReception.ucOctet6 = ucOctetTemp;
 314   2                        ucCheckSum = ucCheckSum + stReception.ucOctet6;
 315   2                        ucCompteurBuffer++;
 316   2                      break;
 317   2                      
 318   2                      case 7:
 319   2                        if(ucCheckSum == ucOctetTemp)
 320   2                        {
 321   3                              stReception.ucOctet7 = ucOctetTemp;
 322   3                              bTrame = RECU;                                                          // Indique que la trame est bonne et bien recue
 323   3                              ucCheckSum = 0;                                                         
 324   3                        }
 325   2                        ucCompteurBuffer = 0;                                                 // Reset du buffer 
 326   2                break;
 327   2                        
 328   2                default:
 329   2                break;                
 330   2              }
 331   1      }
