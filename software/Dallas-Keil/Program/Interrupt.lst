  10          //      Paramètres de sortie : Aucun
  11          //
  12          void vInitInterrupt (void) 
  13          // *************************************************************************************************
  14          {       
  15   1              ET0 = 1;        // Active interruption Timer0
  16   1              ES0 = 1;        // Active interruption RS232 
  17   1              EA  = 1;        // Active interruption globales 
  18   1      }
  19          
  20          // *************************************************************************************************
  21          //      Auteur: Alexandre Dionne
  22          //  Date de création :  17 novembre 2023
  23          //
  24          //      Description :     
  25          //                                
  26          //
  27          //      Paramètres d'entrée  : Aucun            
  28          //      Paramètres de sortie : Aucun
  29          //
  30          void InterruptionTimer0 (void) interrupt 1 
  31          // *************************************************************************************************
  32          {
  33   1              static unsigned char ucTemps;   
  34   1              
  35   1              ucTemps++;                                      
  36   1              ucTemps300ms++;
  37   1              TL0 = 0x00;
  38   1              TH0 = 0x4C;                             // Valeur pour 50ms
  39   1              TF0 = 0;
  40   1              
  41   1              if(ucTemps%4 == 0)                      // 50ms x 4 = 200ms
  42   1              {
  43   2                      bDelai200ms = 1;
  44   2              }
  45   1              if(ucTemps300ms%6 == 0)         // 50ms x 6 = 200ms
  46   1              {
  47   2                      bDelai300ms = 1;
  48   2              }
  49   1              if(ucTemps == 40)                       // 50ms x 40 = 2sec 
  50   1              {
  51   2                      bDelai2s = 1;
  52   2                      ucTemps = 0;                    // Reset Compteur temps
  53   2              }
  54   1      }
