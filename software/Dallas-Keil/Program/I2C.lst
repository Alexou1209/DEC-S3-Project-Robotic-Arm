   6          // *************************************************************************************************
   7          //  Auteur: Stéphane Deschênes
   8          //
   9          //  Description: fonction de délai pour la communication I2C
  10          //  Paramètres d'entrées : iTemps
  11          //  Paramètres de sortie : Aucun
  12          //  Notes                            : Aucune
  13          //
  14          void vI2CDelai (unsigned int iTemps)
  15          // *************************************************************************************************
  16          {
  17   1              while (iTemps > 0) //Effectue la boucle le nombre de fois indiqué dans le paramètre
  18   1              {
  19   2                      iTemps --;
  20   2              }
  21   1      }
  22                  
  23          // *************************************************************************************************
  24          //  Auteur: Stéphane Deschênes, basé sur des fonctions faites par Alain Champagne le 30 mai 2007
  25          //  Date de création :  28 mai 2021
  26          //
  27          //  Description: provoque un "start-condition" I2C sur les lignes SDA et SCL
  28          //  Paramètres d'entrées : Aucun
  29          //  Paramètres de sortie : Aucun
  30          //  Notes                            : Aucune
  31          //
  32          void vI2CStartBit(void)
  33          // *************************************************************************************************
  34          {
  35   1              SDA = 1;                                                                //Mets SDA à 0 lorsque  SCL est à 1.Mets ensuite SCL à 0  
  36   1              vI2CDelai (I2C_DELAI);
  37   1              SCL = 1;
  38   1              vI2CDelai (I2C_DELAI);
  39   1              SDA = 0;          
  40   1              vI2CDelai (I2C_DELAI);
  41   1              SCL = 0;
  42   1              vI2CDelai (I2C_DELAI);
  43   1              
  44   1      }
  45          
  46          // *************************************************************************************************
  47          //  Auteur: Stéphane Deschênes, basé sur des fonctions faites par Alain Champagne le 30 mai 2007
  48          //  Date de création :  28 mai 2021
  49          //
  50          //  Description: provoque un "stop-condition" I2C sur les lignes SDA et SCL
  51          //  Paramètres d'entrées : Aucun
  52          //  Paramètres de sortie : Aucun
  53          //  Notes                : Aucune
  54          //
C51 COMPILER V9.53.0.0   I2C                                                               12/18/2023 17:45:42 PAGE 2   

  55          void vI2CStopBit(void)
  56          // *************************************************************************************************
  57          {
  58   1              SDA = 0;                                                                //Mets SDA à 1 lorsque SCL est à 1.Mets ensuite SCL à 0
  59   1              vI2CDelai (I2C_DELAI);
  60   1              SCL = 1;
  61   1              vI2CDelai (I2C_DELAI);
  62   1              SDA = 1;
  63   1              vI2CDelai (I2C_DELAI);
  64   1              SCL = 0;
  65   1              vI2CDelai (I2C_DELAI);
  66   1      }
  67          
  68          // *************************************************************************************************
  69          //  Auteur: Alexandre Dionne
  70          //  Date de création : 15 septembre 2023 
  71          //
  72          //  Description: Fonction qui permet d'écrire un bit en communication I2C
  73          //  Paramètres d'entrées : bBit ; valeur souhaité du bit à écrire
  74          //  Paramètres de sortie : Aucun
  75          //  Notes                      : Aucune
  76          //
  77          void vI2CEcrireUnBit(bit bBit)
  78          // *************************************************************************************************
  79          {
  80   1              SCL = 0;                                                                //Mets SDA à la valeur transférer puis mets SCL à 1
  81   1              vI2CDelai (I2C_DELAI);
  82   1              if (bBit) {SDA = 1;}
  83   1              else              {SDA = 0;}
  84   1              vI2CDelai (I2C_DELAI);
  85   1              SCL = 1;
  86   1              vI2CDelai (I2C_DELAI);
  87   1              SCL = 0;
  88   1              vI2CDelai (I2C_DELAI);
  89   1              SDA = 1;
  90   1      }
  91          
  92          // *************************************************************************************************
  93          //  Auteur: Alexandre Dionne
  94          //  Date de création :  15 septembre 2023
  95          //
  96          //  Description: Fonction qui permet de lire un bit en communication I2C
  97          //  Paramètres d'entrées : Aucun
  98          //  Paramètres de sortie : La valeur du bit lu
  99          //  Notes                      : Aucune
 100          //
 101          bit bI2CLireUnBit()
 102          // *************************************************************************************************
 103          {
 104   1              bit bBit;                                                               //Met SDA a 1 et SCL à 0, attend légerement et mets SCL a 1.
 105   1              SDA = 1;                                                                //lit ensuite la valeur sur SDA
 106   1              vI2CDelai (I2C_DELAI);
 107   1              SCL = 0;
 108   1              vI2CDelai (I2C_DELAI);
 109   1              SCL = 1;
 110   1              vI2CDelai (I2C_DELAI);
 111   1              bBit = SDA;
 112   1              SCL = 0;
 113   1              return bBit;
 114   1      }
 115          
 116          // *************************************************************************************************
C51 COMPILER V9.53.0.0   I2C                                                               12/18/2023 17:45:42 PAGE 3   

 117          //  Auteur: Alexandre Dionne
 118          //  Date de création :  15 septembre 2023
 119          //  
 120          //  Description          : Fonction d'envoie de 8 bits de données en I2C.
 121          //  Paramètres d'entrées : Octet que l'on veut envoyer
 122          //  Paramètres de sortie : État du ack venant de l'esclave
 123          //  Notes                                        : Aucune
 124          //
 125          void vI2CEcrire8Bits (unsigned char ucTxData)
 126          // *************************************************************************************************
 127          {
 128   1              UC i;                                                                   
 129   1              bit bBit;
 130   1              for(i=0; i<8; i++)                              //Boucle qui appelle la fonction EcrireUnBit 8 fois, en lui transférant
 131   1              {                                                                                                       //la valeur du bit de chaque position (0,1,2,3,4,5,6,7)
 132   2                      if((ucTxData & 0x80) == 0x80){bBit = 1;}
 133   2                      else                                         {bBit = 0;}
 134   2                      vI2CEcrireUnBit(bBit);
 135   2                      ucTxData = ucTxData << 1;
 136   2              }
 137   1              bI2CLireUnBit();
 138   1      }
 139          
 140          // *************************************************************************************************
 141          //      Auteur: Alexandre Dionne
 142          //  Date de création :  15 septembre 2023
 143          //
 144          //      Description :   Fonction de réception de 8 bits de donnée 
 145          //                              provenant d'une communication I2C.
 146          //
 147          //      Paramètres d'entrée :   Valeur du ack voulu 0 = Ack  1 = NACK           
 148          //      Paramètres de sortie :  Octet reçu.             
 149          //
 150          unsigned char ucI2CLire8Bits (bit bAckValue)
 151          // *************************************************************************************************
 152          {
 153   1              UC ucRxData;
 154   1              UC ucTempo = 0;
 155   1              UC i;
 156   1              for(i=0; i<8; i++)                              //Boucle qui appelle 8 fois la fonction LireUnBit, et stocke les 8 bits                 
 157   1              {                                                                                                       //reçus dans une variable qui est retournée.
 158   2                      ucRxData = ucRxData << 1;
 159   2                      ucTempo = bI2CLireUnBit();
 160   2                      ucRxData = ucTempo + ucRxData;
 161   2              }
 162   1              vI2CEcrireUnBit(bAckValue);
 163   1              return ucRxData;
 164   1      }


